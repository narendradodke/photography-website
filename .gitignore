# ==========================================
# LensFrame Photography - Root .gitignore
# ==========================================

# 1. Environment & Secrets
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example
!backend/.env.example
!frontend/.env.example

# Local Certificates, Keys & Secrets
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub

# 2. Database Files & Backups (SQLite)
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.bak
*.backup
*.sql
*.dump

# 3. User Uploads & Media Storage
uploads/
backend/uploads/
*.local-media

# 4. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Node.js & Frontend Build Artifacts
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
.eslintcache
.stylelintcache

# 6. Python & Backend Cache / Test Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 7. Temporary & OS-Generated Files
*.tmp
*.temp
tmp/
temp/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 8. IDE & Editor Configs
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
