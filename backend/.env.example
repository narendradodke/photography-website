APP_NAME=LensFrame API
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_PATH=backend/lensframe.db

# Security & JWT
JWT_SECRET=replace-with-a-random-secure-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Initial Admin Bootstrap (Used only if no admin accounts exist in database)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@lensframe.com
INITIAL_ADMIN_PASSWORD=ChangeThisPasswordPromptly123!

# Uploads
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=25

# SMTP Email Settings (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=arjun@lensframe.com
